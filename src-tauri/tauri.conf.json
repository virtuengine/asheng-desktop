{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Asheng",
  "version": "1.1.1",
  "identifier": "com.shengfeng.asheng",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "shortDescription": "阿盛桌面端",
    "longDescription": "盛峰门业生产数据与智能助手桌面端",
    "resources": ["nsis/voice-install.ps1"],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false,
        "installerHooks": "nsis/hooks.nsh"
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-",
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist",
      "dmg": {
        "windowSize": { "width": 660, "height": 420 }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYxNEJDRDEyRjQ2ODFDRjkKUldUNUhHajBFczFMOGJKNGNXTzh0VXF0QVI4Vzh0UFFwbXRpWWJBMzJia2lwWHlkYVhnNVh0UEIK",
      "endpoints": [
        "https://43.142.55.26:8668/dl/desktop/update-win.json"
      ]
    }
  }
}
